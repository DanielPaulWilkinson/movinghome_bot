# Copy to .env (git-ignored) and fill in. Never commit the real .env.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat ids allowed to use the bot (yours and Jess's).
# Message the bot, then check the log line "/start from chat <id>".
ALLOWED_CHAT_IDS=
ALERT_INTERVAL_MINUTES=60
# Off by default: Rightmove's terms prohibit automated access. Read the README.
RIGHTMOVE_SCRAPE_ENABLED=false
REQUEST_DELAY_SECONDS=10
MAX_PAGES=1
LOG_LEVEL=INFO
